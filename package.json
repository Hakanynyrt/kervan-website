    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml}\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260417.1",
    "@eslint/js": "^9.15.0",
