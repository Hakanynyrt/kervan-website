# Cache policy — Vite-hashed assets are immutable for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos / videos / brand logos / fonts — also immutable (filename is the
# version key — replace the file to update).
/photos/*
  Cache-Control: public, max-age=31536000, immutable
/videos/*
  Cache-Control: public, max-age=31536000, immutable
/brand-logos/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons / logos / OG image — long cache, name doesn't change often.
/favicon-32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/logo-krv-128.png
  Cache-Control: public, max-age=86400
/logo-krv-128.webp
  Cache-Control: public, max-age=86400
/logo-krv.png
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400

# HTML — always revalidate so deploys propagate immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Sitemap / robots — short TTL.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# Apply security headers globally.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
