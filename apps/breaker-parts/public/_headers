# Cache policy — Vite-hashed assets are immutable for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Photos / videos / brand logos — immutable, filename is the version key.
/photos/*
  Cache-Control: public, max-age=31536000, immutable
/videos/*
  Cache-Control: public, max-age=31536000, immutable
/brand-logos/*
  Cache-Control: public, max-age=31536000, immutable
/sister/*
  Cache-Control: public, max-age=31536000, immutable

# 3D model — immutable, large (~45 KB).
/*.glb
  Cache-Control: public, max-age=31536000, immutable

# Favicons / logos / OG — short cache.
/favicon-32-02.png
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon-02.png
  Cache-Control: public, max-age=31536000, immutable
/favicon-16-02.png
  Cache-Control: public, max-age=31536000, immutable
/logo-krv-v2.svg
  Cache-Control: public, max-age=31536000, immutable
/logo-krv-v2-256.png
  Cache-Control: public, max-age=31536000, immutable
/og.png
  Cache-Control: public, max-age=86400

# HTML — always revalidate so deploys propagate immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Sitemap / robots — short TTL.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# Owner-only tech page shell: never indexed (the page also has meta robots).
/teknik-bilgiler
  X-Robots-Tag: noindex, nofollow
/en/teknik-bilgiler
  X-Robots-Tag: noindex, nofollow

# Apply security headers globally.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
