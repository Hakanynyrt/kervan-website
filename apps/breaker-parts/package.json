{
  "name": "@kervan/breaker-parts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.11",
    "@kervan/motion": "workspace:*",
    "@kervan/seo": "workspace:*",
    "@kervan/tips": "workspace:*",
    "@kervan/ui": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "framer-motion": "^11.11.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
