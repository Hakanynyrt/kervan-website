# Open to search engines: no X-Robots-Tag; the cart and 404 pages carry meta robots noindex.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Tip renders: file name = geometry hash, so a changed tip gets a new file. Other sites cannot
# embed them (the zone's Hotlink Protection skips .webp); crawlers and link previews are unaffected.
/tips/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-site

# Our stock photos: a changed picture gets a new file name.
/photos/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-site

# Link-preview pictures (og:image of the home, listing and part pages): a changed picture gets a
# new file name. No CORP header: social-network crawlers fetch them cross-site.
/og/*
  Cache-Control: public, max-age=31536000, immutable

# Interactive 3D part models (GLB): a changed model gets a new file name.
/models/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: model/gltf-binary
  Cross-Origin-Resource-Policy: same-site

