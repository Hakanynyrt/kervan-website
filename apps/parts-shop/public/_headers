# Open to search engines: no X-Robots-Tag; the cart and 404 pages carry meta robots noindex.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Tip renders: file name = geometry hash, so a changed tip gets a new file. Other sites cannot
# embed them (the zone's Hotlink Protection skips .webp); crawlers and link previews are unaffected.
/tips/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-site

# Our stock photos: a changed picture gets a new file name.
/photos/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-site

# Interactive 3D part models (GLB): a changed model gets a new file name.
/models/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: model/gltf-binary
  Cross-Origin-Resource-Policy: same-site

/favicon-32-02.png
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/apple-touch-icon-precomposed.png
  Cache-Control: public, max-age=86400
/apple-touch-icon-02.png
  Cache-Control: public, max-age=31536000, immutable
/favicon-16-02.png
  Cache-Control: public, max-age=31536000, immutable
/icon-192-02.png
  Cache-Control: public, max-age=31536000, immutable
/icon-512-02.png
  Cache-Control: public, max-age=31536000, immutable
/icon-maskable-512-02.png
  Cache-Control: public, max-age=31536000, immutable
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
/logo-krv-v2.svg
  Cache-Control: public, max-age=31536000, immutable
/logo-krv-v2-256.png
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The *.pages.dev hosts (production alias and branch previews, possibly DEMO data) stay out of
# search results; only kiriciparca.com is indexed.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
