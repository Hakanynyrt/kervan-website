# M1 preview: every response is noindex (also robots.txt Disallow and meta robots).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Tip renders: file name = geometry hash, so a changed tip gets a new file. Other sites cannot
# embed them (the zone's Hotlink Protection skips .webp); crawlers and link previews are unaffected.
/tips/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-site

# Our stock photos: a changed picture gets a new file name.
/photos/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-site

/favicon-32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/logo-krv-128.webp
  Cache-Control: public, max-age=86400

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
